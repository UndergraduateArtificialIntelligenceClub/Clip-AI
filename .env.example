# Copy to .env and fill in. Never commit .env.

# OpenAI (pipeline)
OPENAI_API_KEY=
LLM_MODEL=                  # chat model used for scoring
EMBEDDING_MODEL=            # used in version 2

# Backend
DATABASE_URL=postgresql+psycopg://clipai:clipai@localhost:5432/clipai
REDIS_URL=redis://localhost:6379/0
STORAGE_DIR=../storage
PIPELINE_MODE=fake          # fake | real

# Frontend settings live in frontend/.env.local (see frontend/.env.example)
